<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page.title }} - SkibidiMath</title>
</head>
<body>

<!-- ===== NAVIGATION ===== -->
<nav class="main-nav">
    <a href="/">🏠 Home</a>
    <a href="/about.html">📖 About</a>
    <a href="/blog">📝 Blog</a>
    
    <div class="dropdown">
        <a href="#" class="dropbtn">📄 Worksheets ▼</a>
        <div class="dropdown-content">
            <div class="topic-header">📐 Order of Operations</div>
            <div class="sub-dropdown">
                <a href="#">PEMDAS ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/order-of-operations/pemdas-basic.pdf" target="_blank">Basic</a>
                    <a href="/worksheets/order-of-operations/pemdas-intermediate.pdf" target="_blank">Intermediate</a>
                    <a href="/worksheets/order-of-operations/pemdas-advanced.pdf" target="_blank">Advanced</a>
                </div>
            </div>
            <div class="topic-header">🔢 Integers</div>
            <div class="sub-dropdown">
                <a href="#">Integer Operations ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/integers/integer-addition.pdf" target="_blank">Addition</a>
                    <a href="/worksheets/integers/integer-subtraction.pdf" target="_blank">Subtraction</a>
                    <a href="/worksheets/integers/integer-multiplication.pdf" target="_blank">Multiplication</a>
                    <a href="/worksheets/integers/integer-division.pdf" target="_blank">Division</a>
                </div>
            </div>
            <div class="topic-header">⚡ Exponents</div>
            <div class="sub-dropdown">
                <a href="#">Exponent Rules ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/exponents/exponent-rules-basic.pdf" target="_blank">Basic Rules</a>
                    <a href="/worksheets/exponents/exponent-rules-practice.pdf" target="_blank">Practice</a>
                    <a href="/worksheets/exponents/scientific-notation.pdf" target="_blank">Scientific Notation</a>
                </div>
            </div>
            <div class="topic-header">💯 Fractions, Decimals &amp; Percents</div>
            <div class="sub-dropdown">
                <a href="#">Fractions ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/fractions-decimals-percents/fractions-basic.pdf" target="_blank">Basic Fractions</a>
                    <a href="/worksheets/fractions-decimals-percents/fractions-operations.pdf" target="_blank">Operations</a>
                </div>
            </div>
            <div class="sub-dropdown">
                <a href="#">Decimals ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/fractions-decimals-percents/decimals-basic.pdf" target="_blank">Basic Decimals</a>
                    <a href="/worksheets/fractions-decimals-percents/decimals-operations.pdf" target="_blank">Operations</a>
                </div>
            </div>
            <div class="sub-dropdown">
                <a href="#">Percents ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/fractions-decimals-percents/percents-basic.pdf" target="_blank">Basic Percents</a>
                    <a href="/worksheets/fractions-decimals-percents/percents-word-problems.pdf" target="_blank">Word Problems</a>
                </div>
            </div>
            <div class="topic-header">📐 Angles</div>
            <div class="sub-dropdown">
                <a href="#">Angle Worksheets ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/angles/angle-types.pdf" target="_blank">Angle Types</a>
                    <a href="/worksheets/angles/angle-measurement.pdf" target="_blank">Angle Measurement</a>
                    <a href="/worksheets/angles/complementary-supplementary.pdf" target="_blank">Complementary &amp; Supplementary</a>
                </div>
            </div>
            <div class="topic-header">📏 Area &amp; Perimeter</div>
            <div class="sub-dropdown">
                <a href="#">Area Worksheets ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/area-and-perimeter/area-of-triangles.pdf" target="_blank">Area of Triangles</a>
                    <a href="/worksheets/area-and-perimeter/area-of-rectangles.pdf" target="_blank">Area of Rectangles</a>
                    <a href="/worksheets/area-and-perimeter/area-of-circles.pdf" target="_blank">Area of Circles</a>
                    <a href="/worksheets/area-and-perimeter/area-of-composite.pdf" target="_blank">Composite Shapes</a>
                </div>
            </div>
            <div class="sub-dropdown">
                <a href="#">Perimeter Worksheets ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/area-and-perimeter/perimeter-basic.pdf" target="_blank">Basic Perimeter</a>
                    <a href="/worksheets/area-and-perimeter/perimeter-composite.pdf" target="_blank">Composite Perimeter</a>
                </div>
            </div>
            <div class="topic-header">📦 Volume &amp; Surface Area</div>
            <div class="sub-dropdown">
                <a href="#">Volume Worksheets ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/volume-surface-area/volume-prisms.pdf" target="_blank">Volume of Prisms</a>
                    <a href="/worksheets/volume-surface-area/volume-cylinders.pdf" target="_blank">Volume of Cylinders</a>
                    <a href="/worksheets/volume-surface-area/volume-pyramids.pdf" target="_blank">Volume of Pyramids</a>
                </div>
            </div>
            <div class="sub-dropdown">
                <a href="#">Surface Area ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/volume-surface-area/surface-area-prisms.pdf" target="_blank">Surface Area of Prisms</a>
                    <a href="/worksheets/volume-surface-area/surface-area-cylinders.pdf" target="_blank">Surface Area of Cylinders</a>
                </div>
            </div>
            <div class="topic-header">📊 Rates, Ratios &amp; Proportions</div>
            <div class="sub-dropdown">
                <a href="#">Ratios ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/rates-ratios-proportions/ratios-basic.pdf" target="_blank">Basic Ratios</a>
                    <a href="/worksheets/rates-ratios-proportions/ratios-word-problems.pdf" target="_blank">Word Problems</a>
                </div>
            </div>
            <div class="sub-dropdown">
                <a href="#">Proportions ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/rates-ratios-proportions/proportions-basic.pdf" target="_blank">Basic Proportions</a>
                    <a href="/worksheets/rates-ratios-proportions/proportions-word-problems.pdf" target="_blank">Word Problems</a>
                </div>
            </div>
            <div class="topic-header">✏️ Solving Equations</div>
            <div class="sub-dropdown">
                <a href="#">One-Step Equations ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/solving-equations/one-step-addition.pdf" target="_blank">Addition</a>
                    <a href="/worksheets/solving-equations/one-step-subtraction.pdf" target="_blank">Subtraction</a>
                    <a href="/worksheets/solving-equations/one-step-multiplication.pdf" target="_blank">Multiplication</a>
                    <a href="/worksheets/solving-equations/one-step-division.pdf" target="_blank">Division</a>
                </div>
            </div>
            <div class="sub-dropdown">
                <a href="#">Two-Step Equations ▸</a>
                <div class="sub-dropdown-content">
                    <a href="/worksheets/solving-equations/two-step-basic.pdf" target="_blank">Basic</a>
                    <a href="/worksheets/solving-equations/two-step-word-problems.pdf" target="_blank">Word Problems</a>
                </div>
            </div>
        </div>
    </div>
    
    <a href="/privacy.html">🔒 Privacy</a>
    <a href="/contact.html">📧 Contact</a>
    <a href="/terms.html">⚖️ Terms</a>
</nav>

<!-- ===== BLOG POST CONTENT ===== -->
<div style="max-width: 800px; margin: 40px auto; padding: 0 20px;">
    <article style="background: white; padding: 40px; border-radius: 30px; border: 1px solid var(--warm-sand); box-shadow: 0 20px 60px rgba(0,0,0,0.06);">
        <h1 style="color: var(--army-green); font-size: 2.5rem; margin-bottom: 10px;">{{ page.title }}</h1>
        <p style="color: var(--muddy-brown); margin-bottom: 30px;">📅 {{ page.date | date: "%B %d, %Y" }}</p>
        
        <div style="line-height: 1.9; font-size: 1.05rem; color: #333;">
            {{ content }}
        </div>
    </article>
</div>

<!-- ===== FOOTER ===== -->
<footer style="text-align: center; padding: 30px 20px; color: var(--muddy-brown); font-size: 0.9rem; border-top: 1px solid var(--warm-sand); margin-top: 40px;">
    <p>🧮 SkibidiMath — Free math practice for grades 4-7</p>
    <p style="margin-top: 5px; opacity: 0.6;">📧 <a href="mailto:benunumakoe@gmail.com" style="color: var(--army-green);">benunumakoe@gmail.com</a></p>
</footer>

</body>
</html>
